#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/scripts/env.sh"

SSH_PORT_ARG=""

usage() {
  echo "Usage: start <instance> [--ssh-port <port>]" >&2
}

validate_port() {
  if [[ -n "$SSH_PORT" && ! "$SSH_PORT" =~ ^[0-9]+$ ]]; then
    echo "Error: SSH port must be numeric" >&2
    exit 1
  fi
}

# A running container is left alone, so it keeps the socket mount it was
# created with; refuse rather than silently ignore a changed setting.
check_running_docker_socket_mount() {
  local container_id="$1"
  local mounted=false
  if docker inspect -f '{{range .Mounts}}{{println .Destination}}{{end}}' "$container_id" | grep -Fxq /var/run/docker.sock; then
    mounted=true
  fi

  if [[ "$mounted" != "${DANGEROUSLY_MOUNT_DOCKER_SOCKET:-false}" ]]; then
    echo "Error: $INSTANCE is running with docker.sock mounted=$mounted but DANGEROUSLY_MOUNT_DOCKER_SOCKET=${DANGEROUSLY_MOUNT_DOCKER_SOCKET:-false}; recreate it with ./build $INSTANCE, then ./start $INSTANCE" >&2
    exit 1
  fi
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  ""|-*) usage; exit 1 ;;
esac

select_instance "$1"
shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ssh-port)
      if [[ -z "${2:-}" ]]; then
        usage
        exit 1
      fi
      SSH_PORT_ARG="$2"
      shift 2
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

validate_build_configuration
validate_code_dir

if [[ -n "$SSH_PORT_ARG" ]]; then
  SSH_PORT="$SSH_PORT_ARG"
else
  SSH_PORT="${SSH_PORT:-}"
fi

validate_port
set_compose_args

data_dir="$SCRIPT_DIR/data/$INSTANCE"
if [[ ! -d "$data_dir" ]]; then
  echo "Error: instance '$INSTANCE' has no data directory; create $data_dir" >&2
  exit 1
fi
mkdir -p "$data_dir/home"

cd "${SCRIPT_DIR}"

compose_config="$(env BUILD_TARGET="$BUILD_TARGET" SSH_PORT="$SSH_PORT" docker compose "${COMPOSE_ARGS[@]}" config --format json)"
"$SCRIPT_DIR/scripts/check-repo-mounts" compose "$SCRIPT_DIR" "$data_dir" <<< "$compose_config"

container_id="$(env BUILD_TARGET="$BUILD_TARGET" SSH_PORT="$SSH_PORT" docker compose "${COMPOSE_ARGS[@]}" ps -q dev-container 2>/dev/null || true)"
if [[ -n "$container_id" && "$(docker inspect -f '{{.State.Running}}' "$container_id" 2>/dev/null || true)" == "true" ]]; then
  "$SCRIPT_DIR/scripts/check-repo-mounts" inspect "$SCRIPT_DIR" "$data_dir" <<< "$(docker inspect "$container_id")"
  check_running_docker_socket_mount "$container_id"
else
  echo "Starting $INSTANCE..."
  export DOCKER_CLI_HINTS=false
  env BUILD_TARGET="$BUILD_TARGET" SSH_PORT="$SSH_PORT" docker compose "${COMPOSE_ARGS[@]}" up -d
fi
