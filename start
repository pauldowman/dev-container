#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/scripts/env.sh"
load_env_file "$SCRIPT_DIR/.env"

INSTANCE="${DEV_CONTAINER_INSTANCE:-dev-container}"
SSH_PORT="${SSH_PORT:-}"
SSH_PORT_ARG=""

usage() {
  echo "Usage: start [--instance <name>] [--ssh-port <port>]" >&2
}

validate_instance() {
  if [[ ! "$INSTANCE" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    echo "Error: instance must start with a lowercase letter or digit and contain only lowercase letters, digits, underscores, or hyphens" >&2
    exit 1
  fi
  if (( ${#INSTANCE} > 123 )); then
    echo "Error: instance must be at most 123 characters" >&2
    exit 1
  fi
}

validate_port() {
  if [[ -n "$SSH_PORT" && ! "$SSH_PORT" =~ ^[0-9]+$ ]]; then
    echo "Error: SSH port must be numeric" >&2
    exit 1
  fi
}

validate_docker_socket_option() {
  case "${DANGEROUSLY_MOUNT_DOCKER_SOCKET:-false}" in
    true|false) ;;
    *)
      echo "Error: DANGEROUSLY_MOUNT_DOCKER_SOCKET must be true or false" >&2
      exit 1
      ;;
  esac
}

# Setting COMPOSE_FILE disables Compose's automatic override file, so keep it
# when building the default file list.
add_docker_socket_compose_file() {
  if [[ "${DANGEROUSLY_MOUNT_DOCKER_SOCKET:-false}" != "true" ]]; then
    return
  fi

  local compose_files="${COMPOSE_FILE:-}"
  if [[ -z "$compose_files" ]]; then
    compose_files="docker-compose.yml"
    if [[ -f docker-compose.override.yml ]]; then
      compose_files+=":docker-compose.override.yml"
    fi
  fi
  export COMPOSE_FILE="$compose_files:docker-compose.docker-socket.yml"
}

# A running container is left alone, so it keeps the socket mount it was
# created with; refuse rather than silently ignore a changed setting.
check_running_docker_socket_mount() {
  local container_id="$1"
  local mounted=false
  if docker inspect -f '{{range .Mounts}}{{println .Destination}}{{end}}' "$container_id" | grep -Fxq /var/run/docker.sock; then
    mounted=true
  fi

  if [[ "$mounted" != "${DANGEROUSLY_MOUNT_DOCKER_SOCKET:-false}" ]]; then
    echo "Error: $INSTANCE is running with docker.sock mounted=$mounted but DANGEROUSLY_MOUNT_DOCKER_SOCKET=${DANGEROUSLY_MOUNT_DOCKER_SOCKET:-false}; recreate it with ./build --instance $INSTANCE, then ./start --instance $INSTANCE" >&2
    exit 1
  fi
}

validate_build_configuration() {
  if [[ -n "${DOCKERFILE+x}" ]]; then
    echo "Error: DOCKERFILE is obsolete; remove it and use BUILD_TARGET=base or BUILD_TARGET=gui" >&2
    exit 1
  fi

  BUILD_TARGET="${BUILD_TARGET:-base}"
  case "$BUILD_TARGET" in
    base|gui) ;;
    *)
      echo "Error: BUILD_TARGET must be base or gui" >&2
      exit 1
      ;;
  esac
}

validate_repo_location() {
  if [[ -z "${CODE_DIR:-}" ]]; then
    echo "Error: CODE_DIR must be set in .env" >&2
    exit 1
  fi
  if [[ "$CODE_DIR" != /* ]]; then
    echo "Error: CODE_DIR must be an absolute path" >&2
    exit 1
  fi

  local canonical_code_dir
  if ! canonical_code_dir="$(cd "$CODE_DIR" 2>/dev/null && pwd -P)"; then
    echo "Error: CODE_DIR must name an existing directory" >&2
    exit 1
  fi
  if [[ "$CODE_DIR" != "$canonical_code_dir" ]]; then
    echo "Error: CODE_DIR must be a canonical path without symlinks or trailing components" >&2
    exit 1
  fi

  case "$SCRIPT_DIR" in
    "$canonical_code_dir"|"$canonical_code_dir"/*) ;;
    *)
      echo "Error: repository path must be inside CODE_DIR" >&2
      exit 1
      ;;
  esac

  DEV_CONTAINER_REPO_DIR="$SCRIPT_DIR"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --instance)
      if [[ -z "${2:-}" ]]; then
        usage
        exit 1
      fi
      INSTANCE="$2"
      shift 2
      ;;
    --ssh-port)
      if [[ -z "${2:-}" ]]; then
        usage
        exit 1
      fi
      SSH_PORT_ARG="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

validate_instance
selected_instance="$INSTANCE"
load_env_file "$SCRIPT_DIR/.env.$INSTANCE"
INSTANCE="$selected_instance"
validate_build_configuration
validate_repo_location

if [[ -n "$SSH_PORT_ARG" ]]; then
  SSH_PORT="$SSH_PORT_ARG"
else
  SSH_PORT="${SSH_PORT:-}"
fi

validate_port
validate_docker_socket_option

cd "${SCRIPT_DIR}"
add_docker_socket_compose_file

container_id="$(env INSTANCE="$INSTANCE" BUILD_TARGET="$BUILD_TARGET" DEV_CONTAINER_REPO_DIR="$DEV_CONTAINER_REPO_DIR" SSH_PORT="$SSH_PORT" docker compose -p "$INSTANCE" ps -q dev-container 2>/dev/null || true)"
if [[ -n "$container_id" && "$(docker inspect -f '{{.State.Running}}' "$container_id" 2>/dev/null || true)" == "true" ]]; then
  check_running_docker_socket_mount "$container_id"
else
  echo "Starting $INSTANCE..."
  export DOCKER_CLI_HINTS=false
  env INSTANCE="$INSTANCE" BUILD_TARGET="$BUILD_TARGET" DEV_CONTAINER_REPO_DIR="$DEV_CONTAINER_REPO_DIR" SSH_PORT="$SSH_PORT" docker compose -p "$INSTANCE" up -d
fi
