#!/bin/sh
# Preserve an agent containing the signing key; repair dead, empty or wrong-key
# targets on SSH connection and from the startup watchdog. Keep output empty
# because ~/.ssh/rc also runs during scp/sftp sessions.
# Usage: ssh-agent-relink [stable-link [public-key-file]]

link="${1:-$HOME/.ssh/agent.sock}"
signing_key="${2:-$HOME/.ssh/id_ed25519.pub}"
fingerprint=$(ssh-keygen -lf "$signing_key" 2>/dev/null | awk 'NR == 1 { print $2 }')
[ -n "$fingerprint" ] || exit 1

has_signing_key() {
	identities=$(SSH_AUTH_SOCK="$1" ssh-add -l 2>/dev/null) || return 1
	printf '%s\n' "$identities" | awk -v expected="$fingerprint" '
		$2 == expected { found = 1 }
		END { exit !found }
	'
}

has_signing_key "$link" && exit 0

for sock in /tmp/ssh-*/agent.*; do
	[ -S "$sock" ] || continue
	if has_signing_key "$sock"; then
		ln -sf "$sock" "$link" 2>/dev/null || exit 1
		exit 0
	fi
done
exit 1
