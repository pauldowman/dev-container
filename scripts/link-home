#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "link-home: $*" >&2
  exit 1
}

if (( $# != 3 )); then
  fail "usage: link-home SOURCE_ROOT LIST_FILE DESTINATION_ROOT"
fi

trim_trailing_slashes() {
  local path="$1"

  while [[ "$path" != "/" && "$path" == */ ]]; do
    path="${path%/}"
  done
  printf '%s\n' "$path"
}

source_argument="$(trim_trailing_slashes "$1")"
list_file="$2"
destination_argument="$(trim_trailing_slashes "$3")"

[[ -d "$source_argument" ]] || fail "source root is not a directory: $source_argument"
[[ -d "$destination_argument" ]] || fail "destination root is not a directory: $destination_argument"
[[ ! -L "$destination_argument" ]] || fail "destination root must not be a symlink: $destination_argument"
command -v mountpoint >/dev/null || fail "mountpoint command is required"

source_root="$(realpath -e -- "$source_argument")"
destination_root="$(realpath -e -- "$destination_argument")"

[[ "$destination_root" != "/" ]] || fail "destination root must not be the filesystem root"
[[ "$source_root" != "$destination_root" ]] || fail "source and destination roots must differ"

is_same_or_descendant() {
  local path="$1"
  local possible_parent="$2"

  [[ "$path" == "$possible_parent" ]] && return 0
  [[ "$possible_parent" == "/" ]] && return 0
  [[ "$path" == "$possible_parent/"* ]]
}

if is_same_or_descendant "$destination_root" "$source_root"; then
  fail "destination root must not be inside source root"
fi

if [[ ! -e "$list_file" && ! -L "$list_file" ]]; then
  exit 0
fi
[[ -f "$list_file" && -r "$list_file" ]] || fail "cannot read list file: $list_file"

runtime_managed_paths=(.ssh/authorized_keys .ssh/id_ed25519.pub .ssh/agent.sock)

overlaps_runtime_managed_path() {
  local entry="$1"
  local managed

  for managed in "${runtime_managed_paths[@]}"; do
    if is_same_or_descendant "$entry" "$managed" || [[ "$managed" == "$entry/"* ]]; then
      return 0
    fi
  done
  return 1
}

# Errors are prefixed with $3 (the list location) when given.
check_destination_parent() {
  local relative_path="$1"
  local create_missing="$2"
  local where="${3:+$3: }"
  local parent_relative current component remaining

  if [[ "$relative_path" != */* ]]; then
    return
  fi

  parent_relative="${relative_path%/*}"
  current="$destination_root"
  remaining="$parent_relative"

  while [[ -n "$remaining" ]]; do
    component="${remaining%%/*}"
    if [[ "$remaining" == */* ]]; then
      remaining="${remaining#*/}"
    else
      remaining=""
    fi

    current="$current/$component"
    [[ ! -L "$current" ]] || fail "${where}destination parent is a symlink: $current"

    if [[ -e "$current" ]]; then
      [[ -d "$current" ]] || fail "${where}destination parent is not a directory: $current"
    elif [[ "$create_missing" == "true" ]]; then
      mkdir -- "$current"
    fi

    if [[ -e "$current" ]] && mountpoint -q -- "$current"; then
      fail "${where}destination parent is a mountpoint: $current"
    fi
  done
}

check_source_parents() {
  local entry="$1"
  local current="$source_root"
  local component

  IFS=/ read -ra components <<< "$entry"
  for component in "${components[@]:0:${#components[@]}-1}"; do
    current="$current/$component"
    [[ -d "$current" && ! -L "$current" ]] || return 1
  done
}

entries=()
entry_lines=()
declare -A seen_entries=()
line_number=0

while IFS= read -r line || [[ -n "$line" ]]; do
  line_number=$((line_number + 1))
  line="${line%$'\r'}"
  where="$list_file:$line_number"

  [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]] && continue
  [[ ! "$line" =~ ^[[:space:]] && ! "$line" =~ [[:space:]]$ ]] || fail "$where: entry has leading or trailing whitespace"

  [[ "$line" != /* ]] || fail "$where: entry must be relative to the home directory: $line"
  entry="${line%/}"

  IFS=/ read -ra components <<< "$entry"
  [[ "$entry" != */ ]] || fail "$where: entry has an empty path component: $line"
  for component in "${components[@]}"; do
    case "$component" in
      "") fail "$where: entry has an empty path component: $line" ;;
      .|..) fail "$where: entry must not contain . or .. components: $line" ;;
    esac
  done

  [[ -z "${seen_entries[$entry]+x}" ]] || fail "$where: duplicate entry: $entry (also line ${seen_entries[$entry]})"
  seen_entries[$entry]="$line_number"

  if overlaps_runtime_managed_path "$entry"; then
    fail "$where: refusing runtime-managed path or its ancestor: $entry"
  fi

  destination_path="$destination_root/$entry"
  if is_same_or_descendant "$destination_path" "$source_root" || is_same_or_descendant "$source_root" "$destination_path"; then
    fail "$where: entry maps into or over the source root: $entry"
  fi

  check_source_parents "$entry" || fail "$where: a parent of the source entry is missing or a symlink: $source_root/$entry"
  [[ -e "$source_root/$entry" || -L "$source_root/$entry" ]] || fail "$where: source entry does not exist: $source_root/$entry"

  check_destination_parent "$entry" false "$where"
  if [[ -e "$destination_path" && ! -L "$destination_path" && ! -f "$destination_path" ]]; then
    fail "$where: destination exists with an unsupported type: $destination_path"
  fi

  entries+=("$entry")
  entry_lines+=("$line_number")
done < "$list_file"

for (( i = 0; i < ${#entries[@]}; i++ )); do
  for (( j = 0; j < ${#entries[@]}; j++ )); do
    if (( i != j )) && [[ "${entries[j]}" == "${entries[i]}/"* ]]; then
      fail "$list_file:${entry_lines[j]}: entry is nested inside ${entries[i]} (line ${entry_lines[i]})"
    fi
  done
done

for entry in "${entries[@]}"; do
  destination_path="$destination_root/$entry"

  check_destination_parent "$entry" true

  if [[ -L "$destination_path" || -f "$destination_path" ]]; then
    rm -f -- "$destination_path"
  elif [[ -e "$destination_path" ]]; then
    fail "destination exists with an unsupported type: $destination_path"
  fi

  ln -s -- "$source_root/$entry" "$destination_path"
done
