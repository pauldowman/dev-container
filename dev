#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/scripts/env.sh"

usage() {
  echo "Usage: dev <instance> <session-name> | dev <instance> list | dev <instance> --code-dir | dev --init" >&2
}

# The session completion asks `dev <instance> --code-dir` in a subprocess so
# the instance .env, which holds GH_TOKEN, is never sourced into the shell.
print_completion() {
  local self config_dir
  self="$(printf '%q' "$SCRIPT_DIR/dev")"
  config_dir="$(printf '%q' "$SCRIPT_DIR/config")"
  cat <<EOF
_dev() {
  if (( CURRENT == 2 )); then
    local -a instances
    instances=(${config_dir}/*/.env(N:h:t))
    compadd -a instances
  elif (( CURRENT == 3 )); then
    local code_dir
    code_dir="\$(${self} "\${words[2]}" --code-dir 2>/dev/null)" || return 1
    _alternative "args:subcommand:(list)" "dirs:directory: _path_files -/ -W \${(q)code_dir}"
  fi
}
compdef _dev dev
EOF
}

# Runs config/<instance>/first-connect.sh once per container, with GH_TOKEN,
# from the user's login shell so it sees what their shell config exports. No
# -L forwards (another session may hold the ports) and no agent forwarding.
run_first_connect() {
  local script="$INSTANCE_CONFIG_DIR/first-connect.sh"
  if [[ ! -f "$script" ]]; then
    return
  fi

  local remote
  # shellcheck disable=SC2016
  remote='state="$HOME/.cache/dev-container"
mkdir -p "$state"
[ -e "$state/first-connect.done" ] && exit 0
script="$(mktemp)"
trap '\''rm -f "$script"'\'' EXIT
cat > "$script"
exec 9>"$state/first-connect.lock"
if ! flock -n 9; then
  echo "first-connect script is already running in another session; skipping" >&2
  exit 0
fi
[ -e "$state/first-connect.done" ] && exit 0
echo "Running first-connect script..." >&2
"$SHELL" -lic '\''bash -eo pipefail "$1"'\'' first-connect "$script" </dev/null 9>&-
touch "$state/first-connect.done"'

  if ! ssh "${ssh_base_opts[@]}" localhost \
    "GH_TOKEN=$(printf '%q' "$GH_TOKEN") sh -ec $(printf '%q' "$remote")" < "$script"; then
    echo "Warning: first-connect setup ($script) did not complete; it will run again on the next connect" >&2
  fi
}

case "${1:-}" in
  --init)
    if [[ $# -ne 1 ]]; then
      usage
      exit 1
    fi
    print_completion
    exit 0
    ;;
  -h|--help) usage; exit 0 ;;
  ""|-*) usage; exit 1 ;;
esac

select_instance "$1"
shift

if [[ $# -ne 1 ]]; then
  usage
  exit 1
fi

command="$1"

if [ -z "${CODE_DIR:-}" ]; then
  echo "Error: CODE_DIR must be set in $INSTANCE_CONFIG_DIR/.env" >&2
  exit 1
fi

if [[ "$command" == "--code-dir" ]]; then
  printf '%s\n' "$CODE_DIR"
  exit 0
fi

agent_status=0
ssh-add -l >/dev/null 2>&1 || agent_status=$?
if [ "$agent_status" -ne 0 ]; then
  if [ "$agent_status" -ne 1 ]; then
    eval "$(ssh-agent -s)" >/dev/null
  fi
  ssh-add
  if ! ssh-add -l >/dev/null 2>&1; then
    echo "Error: SSH agent has no usable identities after loading keys" >&2
    exit 1
  fi
fi

set_compose_args
port_output="$(docker compose "${COMPOSE_ARGS[@]}" port dev-container 22 2>/dev/null || true)"
if [[ -n "$port_output" ]]; then
  ssh_port="${port_output##*:}"
elif [[ -n "${SSH_PORT:-}" ]]; then
  ssh_port="$SSH_PORT"
else
  echo "Error: could not find SSH port for instance '$INSTANCE'. Start it with ./start $INSTANCE." >&2
  exit 1
fi

ssh_base_opts=(-l "${USERNAME:-$USER}" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o "SetEnv TERM=xterm-256color COLORTERM=truecolor" -p "$ssh_port")
ssh_opts=(-A "${ssh_base_opts[@]}")
if [ -n "${FORWARD_PORTS:-}" ]; then
  IFS=',' read -ra ports <<< "$FORWARD_PORTS"
  for port in "${ports[@]}"; do
    ssh_opts+=(-L "${port%%:*}:localhost:${port##*:}")
  done
fi

case "$command" in
  list)
    ssh "${ssh_opts[@]}" localhost tmux list-sessions
    ;;
  *)
    echo "Connecting to ${USERNAME:-$USER}@localhost:$ssh_port ($INSTANCE)..."
    session_name="${command//\//-}"
    if [ -z "${GH_TOKEN:-}" ]; then
      echo "Warning: GH_TOKEN not set in $INSTANCE_CONFIG_DIR/.env, falling back to 'gh auth token' (which may have broader privileges than needed)" >&2
      GH_TOKEN="$(gh auth token)"
    fi
    run_first_connect
    ssh "${ssh_opts[@]}" -t localhost \
      GH_TOKEN="$GH_TOKEN" \
      tmux new-session -A -s "$session_name" -c "$CODE_DIR/$command"
    ;;
esac
