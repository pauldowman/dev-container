#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/scripts/env.sh"

usage() {
  echo "Usage: build <instance> [docker compose build options]" >&2
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  ""|-*) usage; exit 1 ;;
esac

select_instance "$1"
shift
validate_build_configuration
validate_code_dir
set_compose_args

cd "${SCRIPT_DIR}"
env BUILD_TARGET="$BUILD_TARGET" docker compose "${COMPOSE_ARGS[@]}" down --remove-orphans
docker rm -f "$INSTANCE" 2>/dev/null || true
env BUILD_TARGET="$BUILD_TARGET" docker compose "${COMPOSE_ARGS[@]}" build "$@"
